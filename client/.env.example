# Bollywood Hangman — Client Environment
# Copy to .env and fill in your values

# Backend WebSocket server URL (default: http://localhost:3001)
VITE_SERVER_URL=http://localhost:3001

# OMDB API key for movie search (free at https://www.omdbapi.com/apikey.aspx)
# Leave blank to use the built-in demo movie list
VITE_OMDB_API_KEY=
